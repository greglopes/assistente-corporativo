# Copie para .env e preencha. Nunca faça commit do .env.

# Provedor do modelo: gemini | workers-ai | mock
# "mock" gera respostas simuladas, útil para testar a interface sem chave.
NUXT_AI_PROVIDER=gemini

# Chave gratuita em https://aistudio.google.com/apikey
NUXT_GEMINI_API_KEY=
NUXT_GEMINI_MODEL=gemini-flash-lite-latest

# Limite de uso por IP (protege a cota gratuita)
NUXT_RATE_LIMIT_PER_WINDOW=8
NUXT_RATE_LIMIT_WINDOW_MINUTES=10
